# Порт, на котором слушает backend
PORT=3001

# Origin фронтенда, разрешённый для CORS
FRONTEND_ORIGIN=http://localhost:5173

# Ключ Google Gemini API. Если задан — backend использует Gemini как основную LLM.
GEMINI_API_KEY=

# Модель Gemini, используемая для ответов
GEMINI_MODEL=gemini-3.5-flash-lite

# Ключ Anthropic API. Используется, если GEMINI_API_KEY не задан
# (фиктивные ответы без обращения к реальному LLM, если не задан ни один ключ).
ANTHROPIC_API_KEY=

# Модель Claude, используемая для ответов
ANTHROPIC_MODEL=claude-sonnet-4-6

# Явный выбор провайдера: gemini | anthropic | mock
# Переопределяет автоопределение по наличию ключей.
# LLM_PROVIDER=gemini

# Принудительно включить mock-режим, даже если ключ провайдера задан
# USE_MOCK_LLM=true
