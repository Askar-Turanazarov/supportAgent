# Порт, на котором слушает backend
PORT=3001

# Origin фронтенда, разрешённый для CORS
FRONTEND_ORIGIN=http://localhost:5173

# Ключ Anthropic API. Если не задан — backend работает в mock-режиме
# (фиктивные ответы без обращения к реальному LLM).
ANTHROPIC_API_KEY=

# Модель Claude, используемая для ответов
ANTHROPIC_MODEL=claude-sonnet-4-6

# Принудительно включить mock-режим, даже если ANTHROPIC_API_KEY задан
# USE_MOCK_LLM=true
